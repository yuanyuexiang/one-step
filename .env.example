COMPOSE_PROJECT_NAME=onestep
SITE_URL=https://ai-onestep.com
SITE_HOST=ai-onestep.com
TRAEFIK_NETWORK=replace-with-existing-network
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Use the installed official release tag/digest after compatibility verification.
WORDPRESS_IMAGE=wordpress:php8.3-apache
MYSQL_IMAGE=mysql:8.4
ANYTHINGLLM_IMAGE=mintplexlabs/anythingllm:latest
DB_NAME=onestep
DB_USER=onestep

# Optional services. Keep secrets in ignored env/server runtime configuration.
ONESTEP_SMTP_HOST=
ONESTEP_SMTP_PORT=
ONESTEP_SMTP_USER=
ONESTEP_SMTP_PASSWORD=
ONESTEP_SMTP_FROM=
ONESTEP_SMTP_ENCRYPTION=
ONESTEP_ANYTHINGLLM_API_KEY=
ONESTEP_ANYTHINGLLM_WORKSPACE=
